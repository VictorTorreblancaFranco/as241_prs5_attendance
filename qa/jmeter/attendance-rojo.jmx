<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Attendance - Rojo"><stringProp name="TestPlan.comments">75 usuarios durante 300 segundos consultando asistencia por fecha</stringProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Rojo"><stringProp name="ThreadGroup.num_threads">75</stringProp><stringProp name="ThreadGroup.ramp_time">60</stringProp><stringProp name="ThreadGroup.duration">300</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp></ThreadGroup><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Consultar asistencia por fecha"><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,5085)}</stringProp><stringProp name="HTTPSampler.path">/api/attendance/date?fecha=${__P(fecha,2026-10-12)}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">false</boolProp></HTTPSamplerProxy><hashTree/></hashTree></hashTree></hashTree>
